{
  "name": "minimadesk",
  "productName": "minimaDesk",
  "version": "0.7.12",
  "description": "A polished desktop MiniDapp platform \u2014 runs a full Minima classic node and opens installed MDS MiniDapps as tabs. MiniHub, in a party dress.",
  "author": "eurobuddha",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "build": "vite build --config renderer/vite.config.ts",
    "dev": "concurrently -k \"vite build --watch --mode development --config renderer/vite.config.ts\" \"electron .\"",
    "typecheck": "tsc -p renderer --noEmit",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:signed": "APPLE_KEYCHAIN_PROFILE=minimadesk npm run dist:mac && scripts/verify-mac.sh",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@react-spring/web": "^9.7.3",
    "@types/lodash": "^4.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "date-fns": "^2.30.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "embla-carousel-react": "^8.0.0",
    "embla-carousel-wheel-gestures": "^8.0.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-clipboard.js": "^2.0.16",
    "react-dom": "^18.2.0",
    "react-joyride": "^2.7.2",
    "react-router-dom": "^6.22.0",
    "react-toastify": "^9.1.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.eurobuddha.minimadesk",
    "productName": "minimaDesk",
    "files": [
      "main/**",
      "renderer/dist/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/minima.jar",
        "to": "minima.jar"
      },
      {
        "from": "resources/jre",
        "to": "jre"
      },
      {
        "from": "resources/dapps",
        "to": "dapps"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": "Developer ID Application",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Finance",
      "maintainer": "eurobuddha <eurobuddha@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9"
  }
}
